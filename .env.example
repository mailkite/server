HMAC_SECRET=

# Optional outbound — see api-local/README.md § Outbound (smarthost). Pick one.
#   MailKite Cloud:
# SMARTHOST=cloud
# MAILKITE_SEND_KEY=mk_live_…
#   Amazon SES (ordinary AWS access key pair, not SMTP credentials):
# SMARTHOST=ses
# SES_ACCESS_KEY_ID=AKIA…
# SES_SECRET_ACCESS_KEY=…
# SES_REGION=us-east-1
#   Any SMTP relay:
# SMARTHOST=smtp://user:pass@host:587
