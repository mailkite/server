  "files": [
    "index.js",
    "plugins/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "test": "node scripts/sync.mjs --check && node --test 'test/*.test.mjs'",
    "prepack": "node scripts/sync.mjs --check"
  },
  "keywords": [
    "haraka",
    "haraka-plugin",
    "smtp",
    "mx",
    "email",
    "inbound-email",
    "webhook",
    "mailkite",
    "email-api"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailkite/server.git",
    "directory": "packages/haraka-plugin-mailkite"
  },
  "homepage": "https://github.com/mailkite/server/tree/main/packages/haraka-plugin-mailkite#readme",
  "bugs": "https://github.com/mailkite/server/issues",
  "engines": {
    "node": ">=18"
  }
}
