{
  "name": "haraka-plugin-mailkite",
  "version": "0.1.0",
  "description": "Connect an existing Haraka MX or submission server to a MailKite-contract backend (MailKite Cloud or self-hosted api-local): inbound mail as signed webhooks, anti-open-relay RCPT checks, SMTP AUTH + relay.",
